# sandbox uses Square test cards. production charges real cards.
SQUARE_ENVIRONMENT=sandbox

# Server only. Never expose this in client code.
SQUARE_ACCESS_TOKEN=

# Seller location that receives the payment.
SQUARE_LOCATION_ID=

# Web Payments SDK application id. Required for the card form on checkout.
SQUARE_APPLICATION_ID=

# Public site origin. Square hosted checkout can return buyers here when it is https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coming soon gate. Visitors see Coming Soon until this admin signs in.
# Copy these into .env.local. Do not commit the real password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
