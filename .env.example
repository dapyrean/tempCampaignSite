# sandbox uses Square test cards. production charges real cards.
SQUARE_ENVIRONMENT=sandbox

# Server only. Never expose this in client code.
SQUARE_ACCESS_TOKEN=

# Seller location that receives the payment.
SQUARE_LOCATION_ID=

# Web Payments SDK application id. Required for the card form on checkout.
SQUARE_APPLICATION_ID=

# Public https origin. Leave unset on Vercel so Square returns buyers to the
# deployment host (or a custom domain). Set this only for a fixed production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coming soon gate. Visitors see Coming Soon until this admin signs in.
# Locally these live in .env.local. On Vercel, set the same names under
# Project Settings → Environment Variables. Do not commit the real password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
